# --- Google Sheet = source of truth for products (CSV export) ---
# Sheet must be shared: "Anyone with the link" can view (or at least CSV export must be reachable).

# Your spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
VITE_PRODUCTS_SHEET_ID=15qJiWWGd70_yp4oGqP6zuf3fghMi5alWI3zKK4Vp8rE

# Tab id (first sheet is usually 0). From URL when you open that tab: ...gid=12345
VITE_PRODUCTS_SHEET_GID=0

# Optional: full CSV URL instead of /google-sheet-export (only if fetch works from the browser; Google often blocks CORS — prefer proxy + _redirects).
# VITE_PRODUCTS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_ID/export?format=csv&gid=0

# Re-fetch interval (ms). Default 60000.
VITE_PRODUCTS_REFRESH_MS=60000
